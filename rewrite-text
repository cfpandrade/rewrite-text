def detect_language(text):
    """Idioma del texto por recuento de palabras frecuentes, o None si no está claro."""
    words = re.findall(r"[^\W\d_]+", text.lower())
    scores = sorted(((sum(w in sw for w in words), lang) for lang, sw in STOPWORDS.items()),
                    reverse=True)
    (best, lang), (second, _) = scores[0], scores[1]
    # Empate o mezcla sin idioma dominante: mejor la regla genérica
    if best >= 1 and best >= 1.5 * second:
        return lang
    return None


