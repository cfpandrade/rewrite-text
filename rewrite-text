def load_config():
    try:
        return json.loads(CONFIG.read_text())
    except Exception:
        return {}


def save_config(cfg):
    try:
        CONFIG.write_text(json.dumps(cfg, indent=2))
    except Exception:
        pass


LOG = Path.home() / ".cache" / "rewrite-text.log"


def log(msg):
    """Traza de cada paso: lanzado desde un atajo no hay terminal donde ver qué falla."""
    try:
        with LOG.open("a") as f:
            f.write(f"{time.strftime('%F %T')} [{os.getpid()}] {msg}\n")
    except OSError:
        pass


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def clipboard_get():
    # Pedimos solo texto: si el portapapeles tiene una imagen, wl-paste falla en
    # vez de devolver bytes binarios que reventarían el decode a UTF-8.
    r = subprocess.run(["wl-paste", "-n", "-t", "text"], capture_output=True)
    if r.returncode != 0:
        return ""
    return r.stdout.decode("utf-8", errors="replace")


def clipboard_set(text):
    subprocess.run(["wl-copy", "--", text], check=False)


def release_modifiers():
    """Último recurso si no se puede leer el teclado: keyup falso de los modificadores.

    Tiene efectos secundarios (soltar Super abre Actividades), por eso solo se
    usa cuando wait_keys_released() no puede hacer su trabajo.
    """
    # 125 LEFTMETA, 126 RIGHTMETA, 29 LEFTCTRL, 97 RIGHTCTRL,
    # 42 LEFTSHIFT, 54 RIGHTSHIFT, 56 LEFTALT, 100 RIGHTALT
    run(["ydotool", "key"] + [f"{k}:0" for k in
        (125, 126, 29, 97, 42, 54, 56, 100)])
    time.sleep(0.12)


def wait_keys_released(timeout=3.0):
    """Espera a que el usuario suelte físicamente todas las teclas.

    Si simulamos Ctrl+C con Super o Ctrl del atajo aún pulsadas sale otra
    combinación; y falsificar sus keyup desincroniza el estado de mutter
    (Actividades que se abre y cierra, letras sueltas en vez de pegar).
    """
    try:
        import evdev
        from evdev import ecodes
    except ImportError:
        release_modifiers()
        return

    keyboards = []
    for path in evdev.list_devices():
        try:
            dev = evdev.InputDevice(path)
        except OSError:
            continue
        if ecodes.KEY_A in dev.capabilities().get(ecodes.EV_KEY, []):
            keyboards.append(dev)
        else:
            dev.close()
    if not keyboards:
        release_modifiers()
        return

    deadline = time.monotonic() + timeout
    try:
        while True:
            # Por debajo de BTN_MISC solo hay teclas: se ignoran botones de ratón
            held = [k for d in keyboards for k in d.active_keys() if k < ecodes.BTN_MISC]
            if not held:
                break
            if time.monotonic() > deadline:
                release_modifiers()
                break
            time.sleep(0.02)
    finally:
        for dev in keyboards:
            dev.close()
    time.sleep(0.05)


def press_copy():
    wait_keys_released()
    # 29 = LEFTCTRL, 46 = C  (keycodes de evdev)
    run(["ydotool", "key", "29:1", "46:1", "46:0", "29:0"])


def grab_selection():
    """Ctrl+C simulado y lectura del portapapeles. Devuelve (texto, portapapeles_previo)."""
    previous = clipboard_get()
    press_copy()
    text = ""
    for _ in range(12):
        time.sleep(0.08)
        text = clipboard_get()
        if text and text != previous:
            break
    if not text or text == previous:
        # Fallback: selección primaria (funciona en GTK y XWayland)
        r = run(["wl-paste", "-p", "-n"])
        text = r.stdout if r.returncode == 0 else ""
        log(f"portapapeles sin cambios, selección primaria: {len(text)} caracteres")
    log(f"selección capturada: {len(text.strip())} caracteres")
    return text.strip(), previous


def paste_back():
    wait_keys_released()
    # 29 = LEFTCTRL, 47 = V
    run(["ydotool", "key", "29:1", "47:1", "47:0", "29:0"])


def paste_back_terminal():
    """Como paste_back() pero para terminales (kitty incluida): Ctrl+V ahí lo
    interpreta readline como "insertar literal", no como pegar. El atajo de
    pegado estándar en terminales es Ctrl+Shift+V."""
    wait_keys_released()
    # 29 = LEFTCTRL, 42 = LEFTSHIFT, 47 = V
    run(["ydotool", "key", "29:1", "42:1", "47:1", "47:0", "42:0", "29:0"])


PROBE = "⁣rewrite-text-probe⁣"


def selection_unchanged(original):
    """Vuelve a copiar para saber si la selección original sigue ahí.

    La IA tarda unos segundos; si entretanto se movió el cursor o cambió el
    foco, pegar a ciegas duplicaría el texto o lo metería en otro sitio.
    """
    if not original:
        return False
    clipboard_set(PROBE)
    time.sleep(0.1)
    press_copy()
    current = PROBE
    for _ in range(10):
        time.sleep(0.08)
        current = clipboard_get()
        if current and current != PROBE:
            break
    return current.strip() == original.strip()


def replace_selection(result, original):
    """Pega el resultado sobre la selección solo si sigue siendo la original."""
    if not selection_unchanged(original):
        log("la selección cambió: resultado solo en el portapapeles")
        clipboard_set(result)
        notify("La selección cambió mientras se reescribía. "
               "El resultado está en el portapapeles: pégalo con Ctrl+V.")
        return
    clipboard_set(result)
    # Margen para que wl-copy se registre como dueño del portapapeles antes de pegar
    time.sleep(0.45)
    log("pegando con Ctrl+V")
    paste_back()


def notify(message, urgency="normal"):
    """Feedback para el modo directo, que no tiene ventana donde mostrar errores."""
    run(["notify-send", "-a", "Reescribir texto", "-u", urgency,
         "Reescribir texto", message])


def notify_progress(message):
    r = run(["notify-send", "--print-id", "-e", "-u", "low", "-a", "Reescribir texto",
             "Reescribir texto", message])
    return r.stdout.strip() if r.returncode == 0 else None


def notify_close(nid):
    if nid:
        run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
             "--object-path", "/org/freedesktop/Notifications",
             "--method", "org.freedesktop.Notifications.CloseNotification", nid])


def strip_ai_dashes(text):
    """El prompt ya los prohíbe, pero el modelo recae: aquí no pasa ninguno."""
    text = re.sub(r"(?<=\d)\s*[—–]\s*(?=\d)", "-", text)
    text = re.sub(r"\s*[—–]\s*", ", ", text)
    return re.sub(r",\s*,", ",", text)


def ask_backend(backend, prompt):
    # Directorio vacío como cwd: así no se carga AGENTS.md/CLAUDE.md ni memoria del proyecto
    with tempfile.TemporaryDirectory() as tmp:
        if backend == "codex":
            # --output-last-message da la respuesta limpia, sin cabeceras ni razonamiento
            last = os.path.join(tmp, "out.txt")
            model = load_config().get("codex_model", CODEX_MODEL)
            cmd = ["codex", "exec", "--ephemeral", "--skip-git-repo-check",
                   "-m", model, "-s", "read-only", "-C", tmp, "-o", last, "--color", "never", prompt]
        else:
            last = None
            cmd = ["claude", "-p", "--model", "haiku", prompt]
        log(f"llamando a {backend}")
        r = run(cmd, cwd=tmp, timeout=120)
        log(f"{backend} terminó con código {r.returncode}")
        if r.returncode != 0:
            raise RuntimeError((r.stderr or r.stdout).strip()[-400:] or f"{backend} falló")
        if last and os.path.exists(last):
            out = Path(last).read_text().strip()
        else:
            out = r.stdout.strip()
    if not out:
        raise RuntimeError(f"{backend} no devolvió texto")
    return out.strip()


def extract_answer(out):
    """Solo lo de dentro de <respuesta>: haiku a veces antepone su razonamiento."""
    m = re.search(r"<respuesta>\s*(.*?)\s*(?:</respuesta>|$)", out, re.S)
    return m.group(1) if m else out


def rewrite(backend, tone_desc, text):
    lang = detect_language(text)
    log(f"idioma detectado: {lang or 'dudoso'}")
    if "traducido" in tone_desc:
        language = LANGUAGE_RULE_TRANSLATE
    else:
        language = LANGUAGE_RULE.format(lang=lang, native=NATIVE_RULE[lang]).strip() if lang else LANGUAGE_RULE_UNKNOWN
    prompt = PROMPT.format(tone=tone_desc, language=language, text=text)
    out = extract_answer(ask_backend(backend, prompt))
    # Si aun así cambia de idioma (o cuela su razonamiento en español), un reintento
    if lang and "traducido" not in tone_desc and detect_language(out) not in (lang, None):
        log(f"respuesta en {detect_language(out)}, reintentando")
        out = extract_answer(ask_backend(backend, prompt))
    return strip_ai_dashes(out.strip('"').strip())


def ask_command(backend, prompt):
    out = ask_backend(backend, prompt)
    # El prompt ya lo prohíbe, pero el modelo a veces envuelve el comando en
    # backticks o un bloque ```bash ... ``` pese a la instrucción.
    out = re.sub(r"^```[a-zA-Z]*\n?|```$", "", out.strip()).strip()
    return out.strip('`').strip('"').strip()


def to_command(backend, text):
    return ask_command(backend, CLI_PROMPT.format(text=text))


def shell_mode(args):
    """Para el widget de zsh: imprime el comando corregido por stdout.

    `--shell LINEA` corrige la línea o convierte la petición en comando.
    `--shell --status N COMANDO` corrige un comando que ya falló; la salida
    que produjo (si la hay) llega por stdin.
    """
    status = None
    if args[:1] == ["--status"]:
        if len(args) < 2:
            sys.exit("Uso: rewrite-text --shell [--status N] [--] COMANDO")
        status, args = args[1], args[2:]
    if args[:1] == ["--"]:
        args = args[1:]
    text = " ".join(args).strip()
    if not text:
        sys.exit("No hay comando que corregir.")

    cwd = os.getcwd()
    if status is None:
        prompt = SHELL_LINE_PROMPT.format(cwd=cwd, text=text)
    else:
        output = "" if sys.stdin.isatty() else sys.stdin.read()
        # Lo último es lo que importa: el error suele estar al final
        output = output.strip()[-3000:] or "(no disponible)"
        prompt = SHELL_FIX_PROMPT.format(cwd=cwd, status=status, text=text, output=output)

    backend = load_config().get("backend", "claude")
    try:
        print(ask_command(backend, prompt))
    except Exception as e:  # noqa: BLE001
        sys.exit(f"Error ({backend}): {e}")


class Window(Adw.ApplicationWindow):
    def __init__(self, app, text, previous_clip):
        super().__init__(application=app, title="Reescribir", default_width=560, default_height=460)
        self.previous_clip = previous_clip
        self.original = text
        self.cfg = load_config()

        tv = Adw.ToolbarView()
        header = Adw.HeaderBar()
        self.backend = Gtk.DropDown.new_from_strings(BACKENDS)
        self.backend.set_selected(BACKENDS.index(self.cfg.get("backend", "claude")))
        header.pack_end(self.backend)
        tv.add_top_bar(header)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8,
                      margin_top=8, margin_bottom=8, margin_start=12, margin_end=12)

        box.append(Gtk.Label(label="Original", xalign=0, css_classes=["dim-label"]))
        self.src = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=6, bottom_margin=6,
                                left_margin=6, right_margin=6)
        self.src.get_buffer().set_text(text)
        box.append(self._scrolled(self.src, 90))

        tones = Gtk.Box(spacing=6, homogeneous=True)
        for _slug, label, desc in TONES:
            b = Gtk.Button(label=label)
            b.connect("clicked", self.on_tone, desc)
            tones.append(b)
        box.append(tones)

        self.status = Gtk.Label(label="Resultado", xalign=0, css_classes=["dim-label"])
        box.append(self.status)
        self.dst = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=6, bottom_margin=6,
                                left_margin=6, right_margin=6)
        box.append(self._scrolled(self.dst, 140))

        actions = Gtk.Box(spacing=6, halign=Gtk.Align.END)
        self.btn_copy = Gtk.Button(label="Copiar", sensitive=False)
        self.btn_copy.connect("clicked", self.on_copy)
        self.btn_replace = Gtk.Button(label="Reemplazar", sensitive=False, css_classes=["suggested-action"])
        self.btn_replace.connect("clicked", self.on_replace)
        actions.append(self.btn_copy)
        actions.append(self.btn_replace)
        box.append(actions)

        tv.set_content(box)
        self.set_content(tv)

        esc = Gtk.ShortcutController()
        esc.add_shortcut(Gtk.Shortcut.new(Gtk.ShortcutTrigger.parse_string("Escape"),
                                          Gtk.CallbackAction.new(lambda *a: self.close())))
        self.add_controller(esc)

        if not text:
            self.status.set_label("No se detectó texto seleccionado; pégalo arriba y elige un tono.")

    @staticmethod
    def _scrolled(view, height):
        sw = Gtk.ScrolledWindow(min_content_height=height, vexpand=True, css_classes=["card"])
        sw.set_child(view)
        return sw

    def _text(self, view):
        b = view.get_buffer()
        return b.get_text(b.get_start_iter(), b.get_end_iter(), True)

    def on_tone(self, _btn, tone_desc):
        text = self._text(self.src).strip()
        if not text:
            return
        backend = BACKENDS[self.backend.get_selected()]
        self.cfg["backend"] = backend
        save_config(self.cfg)
        self.status.set_label(f"Reescribiendo con {backend}…")
        self.set_sensitive(False)

        def work():
            try:
                out = rewrite(backend, tone_desc, text)
                GLib.idle_add(self.done, out, None)
            except Exception as e:  # noqa: BLE001
                GLib.idle_add(self.done, None, str(e))

        threading.Thread(target=work, daemon=True).start()

    def done(self, out, err):
        self.set_sensitive(True)
        if err:
            self.status.set_label(f"Error: {err}")
            return
        self.dst.get_buffer().set_text(out)
        self.status.set_label("Resultado")
        self.btn_copy.set_sensitive(True)
        self.btn_replace.set_sensitive(True)
        self.btn_replace.grab_focus()

    def on_copy(self, _b):
        clipboard_set(self._text(self.dst))
        self.close()

    def on_replace(self, _b):
        self.result = self._text(self.dst)
        # Guardar la referencia a la app ANTES de cerrar: una vez destruida la
        # ventana, get_application() devuelve None.
        self.app = self.get_application()
        # hold() es imprescindible: sin el, cerrar la ultima ventana termina el
        # bucle principal y el timeout del pegado no llega a dispararse nunca.
        self.app.hold()
        self.close()
        # Al cerrar, el foco vuelve a la app anterior; pegamos encima de la selección
        GLib.timeout_add(450, self._paste_and_quit)

    def _paste_and_quit(self):
        replace_selection(self.result, self.original)
        # Margen para que wl-copy sirva el portapapeles antes de que salgamos
        GLib.timeout_add(300, self._quit)
        return False

    def _quit(self):
        self.app.release()
        self.app.quit()
        return False


class App(Adw.Application):
    def __init__(self, text, previous_clip):
        super().__init__(application_id="dev.carlos.RewriteText")
        self.text, self.previous_clip = text, previous_clip

    def do_activate(self):
        Window(self, self.text, self.previous_clip).present()


def direct_rewrite(tone_slug):
    """Reescribe y reemplaza la selección sin abrir ventana."""
    if tone_slug not in TONE_BY_SLUG:
        sys.exit(f"Tono desconocido: {tone_slug}. Opciones: {', '.join(TONE_BY_SLUG)}")
    label, desc = TONE_BY_SLUG[tone_slug]
    text, _ = grab_selection()
    if not text:
        notify("No se detectó texto seleccionado.", "critical")
        return
    backend = load_config().get("backend", "claude")
    nid = notify_progress(f"{label}: reescribiendo…")
    try:
        out = rewrite(backend, desc, text)
    except Exception as e:  # noqa: BLE001
        notify_close(nid)
        notify(f"Error en «{label}»: {e}", "critical")
        return
    notify_close(nid)
    replace_selection(out, text)
    # Margen para que wl-copy siga sirviendo el portapapeles antes de que el proceso termine
    time.sleep(0.3)


def direct_command():
    """Convierte la selección (petición en lenguaje natural) en un comando de
    shell y lo pega en su lugar, pensado para terminales como kitty. Solo
    pega: nunca pulsa Enter, para que el comando se revise antes de correrlo."""
    text, _ = grab_selection()
    if not text:
        notify("No se detectó texto seleccionado.", "critical")
        return
    backend = load_config().get("backend", "claude")
    nid = notify_progress("Generando comando…")
    try:
        out = to_command(backend, text)
    except Exception as e:  # noqa: BLE001
        notify_close(nid)
        notify(f"Error generando el comando: {e}", "critical")
        return
    notify_close(nid)
    clipboard_set(out)
    time.sleep(0.45)
    paste_back_terminal()
    time.sleep(0.3)


def main():
    log(f"inicio: {' '.join(sys.argv[1:]) or '(ventana)'}")
    if len(sys.argv) > 1 and sys.argv[1] == "--shell":
        shell_mode(sys.argv[2:])
        return
    if len(sys.argv) > 1 and sys.argv[1] == "--direct-cli":
        direct_command()
        return
    if len(sys.argv) > 1 and sys.argv[1] == "--direct":
        if len(sys.argv) < 3:
            sys.exit(f"Uso: rewrite-text --direct <{'|'.join(TONE_BY_SLUG)}>")
        direct_rewrite(sys.argv[2])
        return
    if len(sys.argv) > 1 and sys.argv[1] == "--stdin":
        text, prev = sys.stdin.read().strip(), ""
    else:
        text, prev = grab_selection()
    App(text, prev).run([])


if __name__ == "__main__":
    main()
